# cloud: Supabase + optional Vercel. local: Postgres from DB_* and the SkillMind API.
SKILLMIND_MODE=cloud
VITE_SKILLMIND_MODE=cloud
# Own-server JWT. Required when SKILLMIND_MODE=local. Never commit a real value.
LOCAL_JWT_SECRET=change-me

# Profile: cloud (Vercel + Supabase). Leave VITE_BASE as /.
# Profile: own server. Set VITE_BASE=/skillmind/, VITE_SKILLMIND_MODE=local,
# and fill DB_* below. The password stays only in the server .env.
VITE_BASE=/
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_SKILLMIND_API_URL=https://itwin.kz/skillmind-api

# Server-only (FastAPI + worker). Never expose these to the browser.
# Own-server Postgres. Used when SKILLMIND_MODE=local. Do not commit the password.
DB_HOST=127.0.0.1
DB_PORT=5440
DB_USER=postgres
DB_PASSWORD=
DB_NAME=skillmind
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=skillmind-media
MINIO_PUBLIC_ENDPOINT=itwin.kz
MINIO_PUBLIC_USE_SSL=true

GEMINI_API_KEY_1=
OPENAI_API_KEY_1=
LITELLM_API_KEY_1=
LITELLM_BASE_URL=http://127.0.0.1:4000
